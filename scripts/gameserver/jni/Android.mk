LOCAL_SRC_FILES := $(shell find $(LIBS)/src/android/curl -name '*.c' -not -path '*/tests/*' -not -path '*/docs/*' -not -path '*/include/*')
LOCAL_STATIC_LIBRARIES := zlib
include $(BUILD_STATIC_LIBRARY)

