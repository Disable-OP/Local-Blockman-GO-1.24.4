# curl (source build, no ssl — loopback http only)
include $(CLEAR_VARS)
LOCAL_MODULE := curl
LOCAL_CFLAGS += -O1 -DHAVE_CONFIG_H -Wno-pointer-arith -Wno-write-strings \
  -Wno-unused-parameter -Wno-sign-compare -Wno-missing-declarations \
  -Wno-missing-prototypes -Wno-strict-prototypes -Wno-format
